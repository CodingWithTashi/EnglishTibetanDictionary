<?xml version="1.0" encoding="utf-8"?>
<!-- The Tibetan pack's strings (TibetanPackResources, Monlam data). A new pack copies this file and its
     values-bo copy as strings_pack_<id>.xml; docs/adding-a-dictionary-pack.md lists the keys. -->
<resources>
    <!-- Name in the UI language; pack_gloss is the name in the other UI language -->
    <string name="pack_name_bo">Tibetan Dictionary</string>
    <string name="pack_gloss_bo">བོད་ཡིག་ཚིག་མཛོད།</string>

    <!-- %1$s: the entry count, already formatted for the app language -->
    <string name="pack_desc_bo">Monlam · Tibetan ↔ English · %1$s entries</string>

    <!-- The dictionary's language, in sentences that name it -->
    <string name="pack_language_bo">Tibetan</string>

    <!-- The name in the pack's script and in Latin letters, the same in every UI language (installing screen, About) -->
    <string name="pack_title_bo" translatable="false">བོད་ཡིག་ཚིག་མཛོད།</string>
    <string name="pack_title_latin_bo" translatable="false">Tibetan Dictionary</string>

    <!-- Onboarding greeting in the pack's language, the same in every UI language: "Tashi delek" -->
    <string name="pack_welcome_bo" translatable="false">བཀྲ་ཤིས་བདེ་ལེགས།</string>

    <!-- Home greeting in the pack's language -->
    <string name="greeting_morning_bo">Good morning · ཞོགས་པ་བདེ་ལེགས།</string>
    <string name="greeting_afternoon_bo">Good afternoon · ཕྱི་དྲོ་བདེ་ལེགས།</string>
    <string name="greeting_evening_bo">Good evening · དགོང་དྲོ་བདེ་ལེགས།</string>

    <!-- What each direction is for (onboarding cards, direction picker) -->
    <string name="direction_desc_bo_en">Tibetan to English</string>
    <string name="direction_desc_bo_bo">Tibetan definitions</string>
    <string name="direction_desc_en_bo">English to Tibetan</string>

    <!-- Licences screen heading of the data licence; the licence name stays in English -->
    <string name="licence_data_bo">Dictionary data · GNU General Public License, version 3</string>
</resources>
