<?xml version="1.0" encoding="utf-8"?>
<!-- The Dzongkha pack's strings (DzongkhaPackResources, DDC data). A new pack copies this file and its
     values-bo copy as strings_pack_<id>.xml; docs/adding-a-dictionary-pack.md lists the keys. -->
<resources>
    <!-- Name in the UI language; pack_gloss is the name in the other UI language -->
    <string name="pack_name_dz">Dzongkha Dictionary</string>
    <string name="pack_gloss_dz">རྫོང་ཁའི་ཚིག་མཛོད།</string>

    <!-- %1$s: the entry count, already formatted for the app language -->
    <string name="pack_desc_dz">DDC · Dzongkha ↔ English · %1$s entries</string>

    <!-- The dictionary's language, in sentences that name it -->
    <string name="pack_language_dz">Dzongkha</string>

    <!-- The name in the pack's script and in Latin letters, the same in every UI language (installing screen, About) -->
    <string name="pack_title_dz" translatable="false">རྫོང་ཁའི་ཚིག་མཛོད།</string>
    <string name="pack_title_latin_dz" translatable="false">Dzongkha Dictionary</string>

    <!-- Onboarding greeting in the pack's language, the same in every UI language: "Kuzu zangpo la" -->
    <string name="pack_welcome_dz" translatable="false">སྐུ་གཟུགས་བཟང་པོ་ལགས།</string>

    <!-- Home greeting in the pack's language: the DDC en-dz entries -->
    <string name="greeting_morning_dz">Good morning · དྲོ་པ་བདེ་ལེགས།</string>
    <string name="greeting_afternoon_dz">Good afternoon · ཉི་མ་བདེ་ལེགས།</string>
    <string name="greeting_evening_dz">Good evening · ཕྱི་རུ་བདེ་ལེགས།</string>

    <!-- What each direction is for (onboarding cards, direction picker) -->
    <string name="direction_desc_dz_en">Dzongkha to English</string>
    <string name="direction_desc_dz_dz">Dzongkha definitions</string>
    <string name="direction_desc_en_dz">English to Dzongkha</string>

    <!-- Licences screen heading of the data licence; the licence name stays in English -->
    <string name="licence_data_dz">Dictionary data · Dzongkha Development Commission, used with permission</string>
</resources>
