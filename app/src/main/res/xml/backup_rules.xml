<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower; Android 12+ reads data_extraction_rules.xml. Keep the two files in step.
     dictionary.db is the installer's copy of the bundled asset (re-created from the APK), so it and its
     side files are left out; user.db and the DataStore preferences are backed up. -->
<full-backup-content>
    <exclude domain="database" path="dictionary.db" />
    <exclude domain="database" path="dictionary.db-journal" />
    <exclude domain="database" path="dictionary.db-shm" />
    <exclude domain="database" path="dictionary.db-wal" />
    <exclude domain="database" path="dictionary.db.tmp" />
</full-backup-content>
