<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+; Android 11 and lower reads backup_rules.xml. Keep the two files in step.
     dictionary-bo.db and dictionary-dz.db are the installer's copies of the bundled assets (re-created from the
     APK); dictionary.db is the pre-pack copy, which the sweep deletes. They and their side files are left out, so
     the 25 MB Auto Backup quota is spent on user.db and the DataStore preferences, which are backed up and transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="dictionary.db" />
        <exclude domain="database" path="dictionary.db-journal" />
        <exclude domain="database" path="dictionary.db-shm" />
        <exclude domain="database" path="dictionary.db-wal" />
        <exclude domain="database" path="dictionary.db.tmp" />
        <exclude domain="database" path="dictionary-bo.db" />
        <exclude domain="database" path="dictionary-bo.db-journal" />
        <exclude domain="database" path="dictionary-bo.db-shm" />
        <exclude domain="database" path="dictionary-bo.db-wal" />
        <exclude domain="database" path="dictionary-bo.db.tmp" />
        <exclude domain="database" path="dictionary-dz.db" />
        <exclude domain="database" path="dictionary-dz.db-journal" />
        <exclude domain="database" path="dictionary-dz.db-shm" />
        <exclude domain="database" path="dictionary-dz.db-wal" />
        <exclude domain="database" path="dictionary-dz.db.tmp" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="dictionary.db" />
        <exclude domain="database" path="dictionary.db-journal" />
        <exclude domain="database" path="dictionary.db-shm" />
        <exclude domain="database" path="dictionary.db-wal" />
        <exclude domain="database" path="dictionary.db.tmp" />
        <exclude domain="database" path="dictionary-bo.db" />
        <exclude domain="database" path="dictionary-bo.db-journal" />
        <exclude domain="database" path="dictionary-bo.db-shm" />
        <exclude domain="database" path="dictionary-bo.db-wal" />
        <exclude domain="database" path="dictionary-bo.db.tmp" />
        <exclude domain="database" path="dictionary-dz.db" />
        <exclude domain="database" path="dictionary-dz.db-journal" />
        <exclude domain="database" path="dictionary-dz.db-shm" />
        <exclude domain="database" path="dictionary-dz.db-wal" />
        <exclude domain="database" path="dictionary-dz.db.tmp" />
    </device-transfer>
</data-extraction-rules>
