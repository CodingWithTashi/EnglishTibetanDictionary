<?xml version="1.0" encoding="utf-8"?>
<!-- dictionary.db is a read-only copy of the bundled asset; only user.db and DataStore are backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="dictionary.db" />
        <exclude domain="database" path="dictionary.db-shm" />
        <exclude domain="database" path="dictionary.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="dictionary.db" />
        <exclude domain="database" path="dictionary.db-shm" />
        <exclude domain="database" path="dictionary.db-wal" />
    </device-transfer>
</data-extraction-rules>
