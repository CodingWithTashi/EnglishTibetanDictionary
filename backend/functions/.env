# Non-secret parameters for the deployed functions (firebase-tools prompts for, or in CI fails on, any param
# without a value here). The Azure key is a Secret Manager secret, not set here.
# Region of the Azure Translator resource, e.g. centralindia; empty for a global (single-service) resource.
AZURE_TRANSLATOR_REGION=eastus
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
