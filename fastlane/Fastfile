# Play Store releases for Tibetan Dictionary. GitHub Actions runs this from .github/workflows/release.yml;
# run it locally with `bundle exec fastlane android release track:internal`. versionName and versionCode
# come from app/build.gradle.kts, so bump versionCode before every release.

skip_docs

PROJECT_DIR = File.expand_path("..", __dir__)
PLAY_PACKAGE = "com.kharagedition.tibetandictionary"
TRACKS = %w[internal alpha beta production].freeze
# SHA-256 of the Play upload certificate (Play Console > App integrity > App signing > Upload key certificate);
# Play rejects bundles signed with any other key.
UPLOAD_CERT_SHA256 = "EA:0A:62:C8:E8:E1:DF:A9:AA:3E:17:36:99:7C:27:A0:AA:FF:22:BE:30:67:9E:F6:BA:9B:07:E6:C0:1B:18:04"

# ["3.0.0", 21] from app/build.gradle.kts.
def gradle_version
  gradle = File.read("#{PROJECT_DIR}/app/build.gradle.kts")
  [gradle[/versionName = "([^"]+)"/, 1], gradle[/versionCode = (\d+)/, 1].to_i]
end

def signer_sha256(aab)
  sh("keytool", "-printcert", "-jarfile", aab, log: false, error_callback: ->(_) {})[/SHA256: ([0-9A-F:]+)/, 1]
end

platform :android do
  desc "Build the release AAB and upload it to a Play track (track:internal|alpha|beta|production validate_only:true)"
  lane :release do |options|
    track = options.fetch(:track, "internal").to_s
    UI.user_error!("Unknown track #{track}; use one of #{TRACKS.join(', ')}") unless TRACKS.include?(track)
    validate_only = options[:validate_only].to_s == "true"
    if UPLOAD_CERT_SHA256.start_with?("PLACEHOLDER")
      UI.user_error!("Set UPLOAD_CERT_SHA256 in fastlane/Fastfile to the Play upload certificate's SHA-256 first")
    end
    json_key = ENV.fetch("PLAY_STORE_JSON_KEY")

    # Fail before the long build if Play already has this versionCode or a newer one.
    version_name, version_code = gradle_version
    on_play = TRACKS.flat_map do |t|
      google_play_track_version_codes(package_name: PLAY_PACKAGE, track: t, json_key_data: json_key)
    end
    if on_play.any? && version_code <= on_play.max
      UI.user_error!("Play already has versionCode #{on_play.max}; set versionCode in app/build.gradle.kts above it")
    end
    UI.important("Releasing #{version_name} (#{version_code}) to #{track}#{' (validate only)' if validate_only}")

    # CI has none of the git-ignored files: write the Firebase config and decode the upload keystore
    # for the RELEASE_* signing config in app/build.gradle.kts.
    if is_ci
      File.binwrite("#{PROJECT_DIR}/app/google-services.json", ENV.fetch("GOOGLE_SERVICES_JSON").unpack1("m"))
      keystore = File.join(ENV.fetch("RUNNER_TEMP", Dir.tmpdir), "upload-keystore.jks")
      File.binwrite(keystore, ENV.fetch("ANDROID_KEYSTORE_BASE64").unpack1("m"))
      ENV["RELEASE_STORE_FILE"] = keystore
      ENV["RELEASE_STORE_PASSWORD"] = ENV.fetch("ANDROID_STORE_PASSWORD")
      ENV["RELEASE_KEY_ALIAS"] = ENV.fetch("ANDROID_KEY_ALIAS")
      ENV["RELEASE_KEY_PASSWORD"] = ENV.fetch("ANDROID_KEY_PASSWORD")
    end

    gradle(project_dir: PROJECT_DIR, task: "bundleRelease", flags: "--no-daemon --stacktrace")
    aab = "#{PROJECT_DIR}/app/build/outputs/bundle/release/app-release.aab"

    signer = signer_sha256(aab)
    UI.message("Signer SHA-256: #{signer || 'none'}")
    unless signer == UPLOAD_CERT_SHA256
      UI.user_error!("The AAB is not signed with the Play upload key; check the ANDROID_* secrets (or RELEASE_* locally)")
    end

    mapping = "#{PROJECT_DIR}/app/build/outputs/mapping/release/mapping.txt"
    upload_to_play_store(
      package_name: PLAY_PACKAGE,
      json_key_data: json_key,
      track: track,
      release_status: "completed",
      version_name: version_name,
      aab: aab,
      mapping: File.exist?(mapping) ? mapping : nil,
      validate_only: validate_only,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end
